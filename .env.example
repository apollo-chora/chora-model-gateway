GATEWAY_HTTP_PORT=8080
GATEWAY_GRPC_PORT=9090
POSTGRES_HOST_PORT=5433
CHORA_LLM_BUDGET_REQUIRED=false
# Tenant-scoped override: comma-separated tenant UUIDs that fail closed (a
# missing active budget window BLOCKS) even when CHORA_LLM_BUDGET_REQUIRED is
# off. Malformed entries fail the boot. Example:
# CHORA_LLM_BUDGET_REQUIRED_TENANTS=00000000-0000-7000-8000-000000000001
CHORA_LLM_BUDGET_REQUIRED_TENANTS=
# Per-tenant ceiling on simultaneously in-flight BILLABLE model invocations,
# enforced BEFORE any provider dispatch on all three paths (Invoke, Embed,
# GroundedSearch). 0 (the default) = unlimited — existing behaviour preserved.
# RECOMMENDED DEMO VALUE: 1 (one billable invocation per demo tenant).
#
# SINGLE-INSTANCE ASSUMPTION — READ BEFORE ENABLING: the counter is
# PROCESS-LOCAL. It is a true ceiling only when every billable request for the
# capped tenant reaches exactly ONE gateway process. If the tenant's traffic can
# reach several replicas the effective ceiling is (value x replicas); either pin
# the tenant's traffic to a single replica, or replace this with shared
# admission (a DB/Redis counter).
#
# WORST-CASE PER-INVOCATION COST (what the ceiling bounds): the model
# configuration is built ENTIRELY from the environment (TEXT_LLM_* /
# IMAGE_LLM_* / EMBEDDING_LLM_*). Those env specs carry NO pricing and NO
# max_output_tokens, so the gateway cannot bound a single invocation's token
# cost. The billable attempts per Invoke are (1 + the agent-declared fallback
# chain), and CHORA_FALLBACK_RETRIES (default 0) adds same-provider retries.
# Grounding (Exa search + synthesis) and image generation are likewise unpriced.
# So the ceiling bounds the overshoot past an exhausted budget to
# (value x worst-case one-invocation cost); it does NOT make the
# check-then-debit atomic.
CHORA_LLM_MAX_CONCURRENT_PER_TENANT=0
# Demo-only embedding-route pin (ChatGPT round 8). When enabled, the gateway
# fails its boot unless the ENV-BUILT registry (TEXT_LLM_* / IMAGE_LLM_* /
# EMBEDDING_LLM_*) still maps the pinned logical id to the approved upstream
# model, with no fallbacks, at the approved provider host, AND the wired
# embedding adapter is the one that entry declares (a registry entry the adapter
# ignores is not a pin). A runtime Embed request for any other model is refused.
# Default OFF so ordinary deployments are unaffected. Every pin field is
# REQUIRED when the pin is enabled — there is no built-in default.
# CHORA_EMBEDDING_PIN_ENABLED=true
# CHORA_EMBEDDING_PIN_LOGICAL_ID=
# CHORA_EMBEDDING_PIN_UPSTREAM_MODEL=
# CHORA_EMBEDDING_PIN_PROVIDER_HOST=
CHORA_EMBEDDING_PIN_ENABLED=false
CHORA_DEFAULT_TENANT_ID=00000000-0000-7000-8000-000000000001
CHORA_DEFAULT_GCID=00000000-0000-7000-8000-000000000002
# ---------------------------------------------------------------------------
# Model configuration — ENV-ONLY and REQUIRED. There is no registry file and no
# built-in default model: the gateway fails its boot unless every role below is
# set. The logical model id a caller sends IS the upstream model name.
# ---------------------------------------------------------------------------
TEXT_LLM_BASE_URL=
TEXT_LLM_FORMAT=responses
TEXT_LLM_MODEL=
TEXT_LLM_API_KEY=
TEXT_LLM_SUPPORT_GROUNDING=false
IMAGE_LLM_BASE_URL=
IMAGE_LLM_FORMAT=images
IMAGE_LLM_MODEL=
IMAGE_LLM_API_KEY=
EMBEDDING_LLM_BASE_URL=
EMBEDDING_LLM_FORMAT=embeddings
EMBEDDING_LLM_MODEL=
EMBEDDING_LLM_API_KEY=
SEARCH_PROVIDER=exa
EXA_API_KEY=
