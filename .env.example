# Copy to .env and fill in only the providers you use.
#
# An entry whose api_key_env is unset here is REFUSED at request time with a
# clear error, rather than silently sending an unauthenticated request to a
# public endpoint. The self-hosted entries (local-llama, local-vllm) declare no
# api_key_env at all, so they need nothing from this file.

# --- host port bindings ------------------------------------------------------
# 8080 and 9090 are frequently already taken on a developer machine. These
# change only the PUBLISHED host port; the container always listens on 8080
# (HTTP) and 9090 (gRPC).
GATEWAY_HTTP_PORT=8080
GATEWAY_GRPC_PORT=9090
POSTGRES_HOST_PORT=5433

# --- tenant attribution -----------------------------------------------------
# The budget row is tenant-scoped, so a tenant id must exist. These defaults
# are stable placeholders; change them if you want a second budget scope.
CHORA_DEFAULT_TENANT_ID=00000000-0000-7000-8000-000000000001
CHORA_DEFAULT_GCID=00000000-0000-7000-8000-000000000002

# --- provider credentials ----------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
INTERNAL_LLM_KEY=
# Meta's api.meta.ai — an OpenAI-compatible aggregator that also serves hosted
# web search on /v1/responses.
META_API_KEY=