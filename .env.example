GATEWAY_HTTP_PORT=8080
GATEWAY_GRPC_PORT=9090
POSTGRES_HOST_PORT=5433
CHORA_LLM_BUDGET_REQUIRED=false
# Tenant-scoped override: comma-separated tenant UUIDs that fail closed (a
# missing active budget window BLOCKS) even when CHORA_LLM_BUDGET_REQUIRED is
# off. Malformed entries fail the boot. Example:
# CHORA_LLM_BUDGET_REQUIRED_TENANTS=00000000-0000-7000-8000-000000000001
CHORA_LLM_BUDGET_REQUIRED_TENANTS=
# Per-tenant ceiling on simultaneously in-flight BILLABLE model invocations,
# enforced BEFORE any provider dispatch on all three paths (Invoke, Embed,
# GroundedSearch). 0 (the default) = unlimited — existing behaviour preserved.
# RECOMMENDED DEMO VALUE: 1 (one billable invocation per demo tenant).
#
# SINGLE-INSTANCE ASSUMPTION — READ BEFORE ENABLING: the counter is
# PROCESS-LOCAL. It is a true ceiling only when every billable request for the
# capped tenant reaches exactly ONE gateway process. If the tenant's traffic can
# reach several replicas the effective ceiling is (value x replicas); either pin
# the tenant's traffic to a single replica, or replace this with shared
# admission (a DB/Redis counter).
#
# WORST-CASE PER-INVOCATION COST (what the ceiling bounds): the configured TEXT
# model arrives through the TEXT_LLM_* env role, whose spec carries NO pricing
# and NO max_output_tokens, so the registry cannot bound a single invocation.
# The largest PRICED ceiling in the committed registry is longcat-2.5-preview
# ($0.30/Mtok in, $1.20/Mtok out, 1M context, 131k output); the
# agent-declared fallback chain makes the billable attempts (1 + len(chain)),
# and CHORA_FALLBACK_RETRIES (default 0) adds same-provider retries. Grounding
# (Exa search + LongCat synthesis) and image generation are unpriced in the
# registry. So the ceiling bounds the overshoot past an exhausted budget to
# (value x worst-case one-invocation cost); it does NOT make the
# check-then-debit atomic.
CHORA_LLM_MAX_CONCURRENT_PER_TENANT=0
# Demo-only embedding-route pin (ChatGPT round 8). When enabled, the gateway
# fails its boot unless the EFFECTIVE loaded registry (CHORA_MODEL_REGISTRY)
# still maps the pinned logical id to the approved upstream model, with no
# fallbacks, at the approved provider host, AND the wired embedding adapter is
# the one that entry declares (a registry entry the adapter ignores is not a
# pin). A runtime Embed request for any other model is refused. Default OFF so
# ordinary deployments are unaffected.
# CHORA_EMBEDDING_PIN_ENABLED=true
# CHORA_EMBEDDING_PIN_LOGICAL_ID=text-embedding-004
# CHORA_EMBEDDING_PIN_UPSTREAM_MODEL=liquid/lfm-2.5-embedding-350m:free
# CHORA_EMBEDDING_PIN_PROVIDER_HOST=openrouter.ai
CHORA_EMBEDDING_PIN_ENABLED=false
CHORA_DEFAULT_TENANT_ID=00000000-0000-7000-8000-000000000001
CHORA_DEFAULT_GCID=00000000-0000-7000-8000-000000000002
TEXT_LLM_BASE_URL=https://api.longcat.ai/openai/v1
TEXT_LLM_FORMAT=responses
TEXT_LLM_MODEL=longcat-2.5-preview
TEXT_LLM_API_KEY=
TEXT_LLM_SUPPORT_GROUNDING=false
IMAGE_LLM_BASE_URL=https://api.meta.ai/v1
IMAGE_LLM_FORMAT=images
IMAGE_LLM_MODEL=muse-image-1.0
IMAGE_LLM_API_KEY=
EMBEDDING_LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_LLM_FORMAT=embeddings
EMBEDDING_LLM_MODEL=text-embedding-3-small
EMBEDDING_LLM_API_KEY=
SEARCH_PROVIDER=exa
EXA_API_KEY=
